---
import { REPO_ISSUES_NEW_URL } from '../lib/site-config';
// Links are sourced from src/lib/site-config.ts (single source of truth for
// repo identity — see MIGRATION.md when moving to projectbluefin/metrics).
---
<div class="issue-bar">
  <a
    href={REPO_ISSUES_NEW_URL}
    class="issue-link"
    target="_blank"
    rel="noopener noreferrer"
  >
    🐛 File an issue
  </a>
</div>

<style>
  .issue-bar {
    display: flex;
    justify-content: flex-end;
    padding: 0.25rem 1rem 0;
  }
  .issue-link {
    font-size: 0.8rem;
    color: var(--color-muted, #888);
    text-decoration: none;
    opacity: 0.75;
  }
  .issue-link:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>
